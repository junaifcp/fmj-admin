# Environment Configuration
# Set VITE_ENV to: development, staging, or production
VITE_ENV=development

# Development Environment
VITE_DEV_API_BASE_URL=http://localhost:3000/api
VITE_DEV_CLERK_PUBLISHABLE_KEY=pk_test_your_dev_clerk_key_here
VITE_DEV_CASHFREE_MODE=sandbox

# Staging Environment
VITE_STAGING_API_BASE_URL=https://staging-api.yourdomain.com/api
VITE_STAGING_CLERK_PUBLISHABLE_KEY=pk_test_your_staging_clerk_key_here
VITE_STAGING_CASHFREE_MODE=sandbox

# Production Environment
VITE_PROD_API_BASE_URL=https://api.yourdomain.com/api
VITE_PROD_CLERK_PUBLISHABLE_KEY=pk_live_your_production_clerk_key_here
VITE_PROD_CASHFREE_MODE=production
