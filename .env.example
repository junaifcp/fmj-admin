# Environment Configuration
# Set VITE_ENV to: development, staging, or production
VITE_ENV=development

# Auth is JWT — email OTP + Google sign-in. No sign-up: admins are provisioned
# through the Users UI, never self-registered.

# Development Environment
# Must match the running Node API. Backend default is port 5001, not 3000.
VITE_DEV_API_BASE_URL=http://localhost:5001/api

# Staging Environment
VITE_STAGING_API_BASE_URL=https://staging-api.yourdomain.com/api

# Production Environment (Vercel project for admin.fitmyskill.com)
# Set these in Vercel → Project → Settings → Environment Variables (Production):
#   VITE_ENV=production
#   VITE_PROD_API_BASE_URL=https://api.resumebuilder.fitmyskill.com/api
#   VITE_PROD_GOOGLE_CLIENT_ID=<Google OAuth client with admin.fitmyskill.com as an authorized JS origin>
VITE_PROD_API_BASE_URL=https://api.resumebuilder.fitmyskill.com/api

# Google Identity Services (authorized JS origin for local dev: http://localhost:8082)
VITE_DEV_GOOGLE_CLIENT_ID=
VITE_STAGING_GOOGLE_CLIENT_ID=
VITE_PROD_GOOGLE_CLIENT_ID=
